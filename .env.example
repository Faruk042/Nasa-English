# ============================================================================
# ALTAR-NASA: Flame in Freefall (v6.3) — Optional External Gateway Template
# Note: The built-in Analytical Physics Solver and Local Ollama require zero
# API keys. Optional cloud gateway keys can also be configured from the
# collapsible panel in "Validation & Settings" (%APPDATA%\AltarNasa_EN\config.json).
# ============================================================================

# 1. Local Ollama Inference Server (100% Offline Autonomy)
OLLAMA_HOST="http://127.0.0.1:11434"

# 2. Optional External Cloud Gateways
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
CUSTOM_OPENAI_BASE_URL=""
