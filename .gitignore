GEMINI.md
AGENTS.md
.agents/
Nasa.spec
Nasa_2.spec
Nasa_3.spec
verify_*.py
capture_*.py

# Python Bytecode, Folder-Local Portable Runtime (.runtime) & Build Outputs
__pycache__/
*.py[cod]
*$py.class
build/
dist/
.runtime/
Nasa_4.exe
*.egg-info/
.venv/
venv/
.pytest_cache/
